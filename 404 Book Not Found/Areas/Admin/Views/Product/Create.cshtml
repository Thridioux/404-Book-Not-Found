@model ProductVM

<div class="card shadow-lg border-0 mt-5 rounded-4">
    <div class="card-header bg-secondary bg-gradient py-4 text-center rounded-top-4">
        <h2 class="text-white mb-0">Create Product</h2>
    </div>

    <div class="card-body p-5">
        <form method="post">
            @* <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div> *@

            <div class="mb-4">
                <label asp-for="Product.Title" class="form-label fw-semibold">Title</label>
                <input asp-for="Product.Title" class="form-control form-control-lg" />
                <span asp-validation-for="Product.Title" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Product.Description" class="form-label fw-semibold">Description</label>
                <textarea asp-for="Product.Description" class="form-control form-control-lg"></textarea>
                <span asp-validation-for="Product.Description" class="text-danger"></span>
            </div>
            <div class="mb-4">
                <label asp-for="Product.ISBN" class="form-label fw-semibold">ISBN</label>
                <input asp-for="Product.ISBN" class="form-control form-control-lg" />
                <span asp-validation-for="Product.ISBN" class="text-danger"></span>
            </div>
            <div class="mb-4">
                <label asp-for="Product.Author" class="form-label fw-semibold">Author</label>
                <input asp-for="Product.Author" class="form-control form-control-lg" />
                <span asp-validation-for="Product.Author" class="text-danger"></span>
            </div>
            <div class="mb-4">
                <label asp-for="Product.ListPrice" class="form-label fw-semibold">ListPrice</label>
                <input asp-for="Product.ListPrice" class="form-control form-control-lg" />
                <span asp-validation-for="Product.ListPrice" class="text-danger"></span>
            </div>
            <div class="mb-4">
                <label asp-for="Product.Price" class="form-label fw-semibold">Price</label>
                <input asp-for="Product.Price" class="form-control form-control-lg" />
                <span asp-validation-for="Product.Price" class="text-danger"></span>
            </div>
            <div class="mb-4">
                <label asp-for="Product.Price50" class="form-label fw-semibold">Price50</label>
                <input asp-for="Product.Price50" class="form-control form-control-lg" />
                <span asp-validation-for="Product.Price50" class="text-danger"></span>
            </div>
            <div class="mb-4">
                <label asp-for="Product.Price100" class="form-label fw-semibold">Price100</label>
                <input asp-for="Product.Price100" class="form-control form-control-lg" />
                <span asp-validation-for="Product.Price100" class="text-danger"></span>
            </div>
            <div class="mb-4">
                <label asp-for="Product.CategoryId" class="form-label fw-semibold">Category</label>
                <select asp-for="Product.CategoryId" asp-items="@Model.CategoryList" class="form-select form-select-lg">
                    <option disabled selected>-- Select Category --</option>
                </select>
                <span asp-validation-for="Product.CategoryId" class="text-danger"></span>
            </div>
            <div class="mb-4">
                <label asp-for="Product.ImageUrl" class="form-label fw-semibold">ImageURL</label>
                <input asp-for="Product.ImageUrl" class="form-control form-control-lg" />
                <span asp-validation-for="Product.ImageUrl" class="text-danger"></span>
            </div>


            <div class="d-flex justify-content-between mt-4">
                <button type="submit" class="btn btn-success px-4 py-2">Create</button>
                <a asp-controller="Product" asp-action="Index" class="btn btn-outline-secondary px-4 py-2">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
