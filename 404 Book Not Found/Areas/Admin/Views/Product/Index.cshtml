@using Book.Models
@model List<Product>

<div class="card shadow-lg border-0 mt-5 rounded-4">
	<div class="card-header bg-secondary bg-gradient py-4 text-center rounded-top-4">
		<h2 class="text-white mb-0">Product List</h2>
	</div>

	<div class="card-body p-5">
		<div class="row mb-4">
			<div class="col-6"></div>
			<div class="col-6 text-end">
				<a asp-controller="Product" asp-action="Create" class="btn btn-success px-4 py-2">
					<i class="bi bi-plus-circle me-2"></i>Create New Product
				</a>
			</div>
		</div>

		<table class="table table-bordered table-striped align-middle text-center">
			<thead class="table-light">
				<tr>
					<th scope="col">Title</th>
					<th scope="col">ISBN</th>
					<th scope="col">Price</th>
					<th scope="col">Author</th>
					<th scope="col">Category</th>
				</tr>
			</thead>
			<tbody>
				@foreach (var obj in Model)
				{
					<tr>
						<td>@obj.Title</td>
						<td>@obj.ISBN</td>
						<td>@obj.ListPrice</td>
						<td>@obj.Author</td>
						<td></td>
						<td>
							<div class="btn-group" role="group">
								<a asp-controller="Product" asp-action="Edit" asp-route-id="@obj.Id" class="btn btn-outline-primary btn-sm">
									<i class="bi bi-pencil-square me-1"></i>Edit
								</a>
								<a asp-controller="Product" asp-action="Delete" asp-route-id="@obj.Id" class="btn btn-outline-danger btn-sm">
									<i class="bi bi-trash-fill me-1"></i>Delete
								</a>
							</div>
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
</div>
