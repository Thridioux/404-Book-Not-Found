@using Book.Models
@model Product

<form method="post" class="mt-5">
    <input asp-for="Id" type="hidden" />

    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-header bg-primary bg-gradient text-white text-center py-4 rounded-top-4">
            <h2 class="mb-0">Edit Product</h2>
        </div>

        <div class="card-body p-5">
            @* <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div> *@

            <div class="mb-4">
                <label asp-for="Title" class="form-label fw-semibold">Title</label>
                <input asp-for="Title" class="form-control form-control-lg" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Description" class="form-label fw-semibold">Description</label>
                <textarea asp-for="Description" class="form-control form-control-lg"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="mb-4">
                <label asp-for="ISBN" class="form-label fw-semibold">ISBN</label>
                <input asp-for="ISBN" class="form-control form-control-lg" />
                <span asp-validation-for="ISBN" class="text-danger"></span>
            </div>
            <div class="mb-4">
                <label asp-for="Author" class="form-label fw-semibold">Author</label>
                <input asp-for="Author" class="form-control form-control-lg" />
                <span asp-validation-for="Author" class="text-danger"></span>
            </div>
            <div class="mb-4">
                <label asp-for="ListPrice" class="form-label fw-semibold">ListPrice</label>
                <input asp-for="ListPrice" class="form-control form-control-lg" />
                <span asp-validation-for="ListPrice" class="text-danger"></span>
            </div>
            <div class="mb-4">
                <label asp-for="Price" class="form-label fw-semibold">Price</label>
                <input asp-for="Price" class="form-control form-control-lg" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>
            <div class="mb-4">
                <label asp-for="Price50" class="form-label fw-semibold">Price50</label>
                <input asp-for="Price50" class="form-control form-control-lg" />
                <span asp-validation-for="Price50" class="text-danger"></span>
            </div>
            <div class="mb-4">
                <label asp-for="Price100" class="form-label fw-semibold">Price100</label>
                <input asp-for="Price100" class="form-control form-control-lg" />
                <span asp-validation-for="Price100" class="text-danger"></span>
            </div>

            <div class="d-flex justify-content-between mt-4">
                <button type="submit" class="btn btn-success px-4 py-2">Update</button>
                <a asp-controller="Product" asp-action="Index" class="btn btn-outline-secondary px-4 py-2">Back to List</a>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
