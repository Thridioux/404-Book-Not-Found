@using Book.Models
@model Product

<form method="post" class="mt-5">
    @* <input asp-for="Id" type="hidden" /> *@

    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-header bg-danger bg-gradient text-white text-center py-4 rounded-top-4">
            <h2 class="mb-0">Delete Product</h2>
        </div>

        <div class="card-body p-5">
            <div class="mb-4">
                <label asp-for="Title" disabled class="form-label fw-semibold">Product Name</label>
                <input asp-for="Title" class="form-control form-control-lg" />
            </div>

            <div class="mb-4">
                <label asp-for="Description" disabled class="form-label fw-semibold">Display Order</label>
                <input asp-for="Description" class="form-control form-control-lg" />
            </div>
            <div class="mb-4">
                <label asp-for="ISBN" disabled class="form-label fw-semibold">Display Order</label>
                <input asp-for="ISBN" class="form-control form-control-lg" />
            </div>
            <div class="mb-4">
                <label asp-for="Author" disabled class="form-label fw-semibold">Display Order</label>
                <input asp-for="Author" class="form-control form-control-lg" />
            </div>
            <div class="mb-4">
                <label asp-for="ListPrice" disabled class="form-label fw-semibold">Display Order</label>
                <input asp-for="ListPrice" class="form-control form-control-lg" />
            </div>
            <div class="mb-4">
                <label asp-for="Price" disabled class="form-label fw-semibold">Display Order</label>
                <input asp-for="Price" class="form-control form-control-lg" />
            </div>
            <div class="mb-4">
                <label asp-for="Price50" disabled class="form-label fw-semibold">Display Order</label>
                <input asp-for="Price50" class="form-control form-control-lg" />
            </div>
            <div class="mb-4">
                <label asp-for="Price100" disabled class="form-label fw-semibold">Display Order</label>
                <input asp-for="Price100" class="form-control form-control-lg" />
            </div>

            <div class="d-flex justify-content-between mt-4">
                <button type="submit" class="btn btn-danger px-4 py-2">Delete</button>
                <a asp-controller="Product" asp-action="Index" class="btn btn-outline-secondary px-4 py-2">Back to List</a>
            </div>
        </div>
    </div>
</form>
