@model Category

<form method="post" class="mt-5">
    @* <input asp-for="Id" hidden /> *@
    <div class="card shadow-lg border-0 rounded-3">
        <div class="card-header bg-primary text-white">
            <h2 class="text-center">Delete Category</h2>
        </div>
        @* <div asp-validation-summary="ModelOnly"></div> *@
        <div class="card-body p-4">
            <div class="mb-3">
                <label asp-for="Name" class="form-label">Category Name</label>
                <input asp-for="Name" disabled class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="DisplayOrder" class="form-label">Display Order</label>
                <input asp-for="DisplayOrder" disabled class="form-control" />
            </div>

            <div class="d-flex justify-content-between">
                <button type="submit" class="btn btn-danger w-45">Delete</button>
                <a asp-controller="Category" asp-action="Index" class="btn btn-secondary w-45">Back to List</a>
            </div>
        </div>
    </div>
</form>

